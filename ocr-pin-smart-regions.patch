+/* SPDX-License-Identifier: LGPL-2.0-or-later */
+#include "MultilingualOcr.h"
+
+#include <KLocalizedString>
+#include <QDir>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
